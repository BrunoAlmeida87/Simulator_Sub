{
  "name": "simulador-submarino",
  "private": true,
  "version": "0.2.0",
  "description": "Simulador técnico de submarino convencional fictício (SX-1) — plataforma de simulação de engenharia e treinamento conceitual.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/assets/gallery_catalog.mjs",
    "prebuild": "node scripts/assets/gallery_catalog.mjs",
    "modelos:exportar": "python3.13 scripts/assets/export_gallery_blends.py public/models",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run && vite-node scripts/report.ts",
    "report": "vite-node scripts/report.ts",
    "modelo:otimizar": "node scripts/blender/otimizar.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
